class Solution {
public:
    int climbStairs(int n) {
        if (n <= 2)
            return n;

        int a = 1, b = 2;

        for (int i = 3; i <= n; i++) {
            int c = a + b;
            a = b;
            b = c;
        }

        return b;
    }
};










#To generate an array according to the given rules and find the maximum value in the generated array.
class Solution {
public:
    int getMaximumGenerated(int n) {
        if (n == 0)
            return 0;

        vector<int> nums(n + 1, 0);

        nums[1] = 1;
        int ans = 1;

        for (int i = 2; i <= n; i++) {
            if (i % 2 == 0)
                nums[i] = nums[i / 2];
            else
                nums[i] = nums[i / 2] + nums[i / 2 + 1];

            ans = max(ans, nums[i]);
        }

        return ans;
    }
};
