#To implement a backtracking algorithm to find all possible subsets of a given array of unique integers.
class Solution {
public:
    vector<vector<int>> ans;

    void solve(int index, vector<int>& nums, vector<int>& current) {
        ans.push_back(current);

        for (int i = index; i < nums.size(); i++) {
            current.push_back(nums[i]);

            solve(i + 1, nums, current);

            current.pop_back();
        }
    }

    vector<vector<int>> subsets(vector<int>& nums) {
        vector<int> current;
        solve(0, nums, current);
        return ans;
    }
};










#To implement a backtracking algorithm to find all unique combinations of numbers that add up to a given target, where each number can be used only once.
class Solution {
public:
    vector<vector<int>> ans;

    void solve(int start, int target, vector<int>& candidates,
               vector<int>& current) {

        if (target == 0) {
            ans.push_back(current);
            return;
        }

        for (int i = start; i < candidates.size(); i++) {

            if (i > start && candidates[i] == candidates[i - 1])
                continue;

            if (candidates[i] > target)
                break;

            current.push_back(candidates[i]);

            solve(i + 1, target - candidates[i],
                  candidates, current);

            current.pop_back();
        }
    }

    vector<vector<int>> combinationSum2(vector<int>& candidates,
                                         int target) {

        sort(candidates.begin(), candidates.end());

        vector<int> current;
        solve(0, target, candidates, current);

        return ans;
    }
};










# To implement a recursive algorithm to find the Lowest Common Ancestor (LCA) of two given nodes in a binary tree.

class Solution {
public:
    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {
        if (root == nullptr || root == p || root == q) {
            return root;
        }

        TreeNode* left = lowestCommonAncestor(root->left, p, q);
        TreeNode* right = lowestCommonAncestor(root->right, p, q);

        if (left != nullptr && right != nullptr) {
            return root;
        }

        return left != nullptr ? left : right;
    }
};









#To implement a program to repeatedly add the digits of a number until the result becomes a single digit.
class Solution {
public:
    int addDigits(int num) {
        while (num >= 10) {
            int sum = 0;
            
            while (num > 0) {
                sum += num % 10;
                num /= 10;
            }
            
            num = sum;
        }
        
        return num;
    }
};










#To implement a program to find the duplicate number in an array without modifying the array and using constant extra space.
class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        int slow = nums[0];
        int fast = nums[0];

        do {
            slow = nums[slow];
            fast = nums[nums[fast]];
        } while (slow != fast);

        slow = nums[0];

        while (slow != fast) {
            slow = nums[slow];
            fast = nums[fast];
        }

        return slow;
    }
};




